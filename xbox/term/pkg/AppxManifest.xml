<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap">
  <Identity Name="BlinkTerm.Terminal" Publisher="CN=tingouw" Version="0.1.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Blink Terminal</DisplayName>
    <PublisherDisplayName>tingouw</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="blink-term.exe" EntryPoint="BlinkTerm.App">
      <uap:VisualElements
        DisplayName="Blink Terminal"
        Description="A Linux terminal (Alpine under the blink emulator), for Claude Code"
        BackgroundColor="#101010"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#101010" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <!-- blink: the guest's network access, and its JIT -->
    <Capability Name="internetClient" />
    <Capability Name="codeGeneration" />
  </Capabilities>
</Package>
